{
  "name": "rieva-exploration-systems-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:physics && npm run test:assets && npm run build && node --test tests/rendered-html.test.mjs",
    "test:physics": "node --experimental-strip-types --test tests/simulation.test.ts tests/surface-studio.test.ts tests/black-hole.test.ts tests/contact-flight.test.ts",
    "test:assets": "node --test tests/missionwear-asset.test.mjs tests/aeris-asset.test.mjs",
    "validate:python": "python3 scripts/validate.py",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "source-map-js": "1.2.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  },
  "type": "module"
}
